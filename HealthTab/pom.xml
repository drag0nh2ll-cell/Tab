<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.healthtab</groupId>
    <artifactId>HealthTab</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        BUILDING:
        Push this project to a GitHub repo -- the included
        .github/workflows/build.yml will compile it automatically and attach
        the finished HealthTab.jar as a downloadable build artifact.
        You can also build locally with `mvn clean package` if you have
        Java 8+ and Maven installed.

        - spigot-api comes from the official Spigot repo, matched to 1.8.8
          since that's what FalixNodes 1.8 servers run.
        - luckperms-api is resolved from Luck's own repository. The
          LuckPerms-Bukkit jar in ./libs is kept as an offline fallback
          (system-scope, commented out below) in case you ever build
          somewhere without access to repo.lucko.me.
    -->

    <repositories>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>luckperms-repo</id>
            <url>https://repo.lucko.me/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Spigot/Bukkit API for 1.8.8 -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.8.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- LuckPerms API, resolved from Luck's repo above -->
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.4</version>
            <scope>provided</scope>
        </dependency>

        <!--
        Fallback if you'd rather not add the luckperms-repo: compile against
        the jar you already have, using it purely for the net.luckperms.api
        classes (LuckPerms is never shaded/bundled into the built plugin
        either way, since scope stays "provided"/"system").
        Delete the <dependency> block above for net.luckperms:api if you use
        this instead, to avoid a duplicate-artifact clash.

        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.4.145</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/LuckPerms-Bukkit-5.4.145.jar</systemPath>
        </dependency>
        -->
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
